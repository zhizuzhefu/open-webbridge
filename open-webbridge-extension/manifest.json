{
  "manifest_version": 3,
  "name": "Open WebBridge",
  "version": "1.1.0",
  "description": "Local, telemetry-free bridge that lets AI agents drive your real browser via the Chrome DevTools Protocol.",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open WebBridge"
  },
  "permissions": [
    "tabs",
    "debugger",
    "storage",
    "alarms",
    "tabGroups",
    "windows",
    "downloads"
  ],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icon/16.png",
    "32": "icon/32.png",
    "48": "icon/48.png",
    "128": "icon/128.png"
  }
}
