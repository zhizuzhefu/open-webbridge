{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.5.3",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open WebBridge",
    "default_icon": {
      "16": "icon/16.png",
      "32": "icon/32.png"
    }
  },
  "permissions": [
    "tabs",
    "debugger",
    "storage",
    "alarms",
    "tabGroups",
    "windows",
    "downloads",
    "scripting"
  ],
  "commands": {
    "toggle-annotate": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Toggle annotation mode on the current page"
    }
  },
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icon/16.png",
    "32": "icon/32.png",
    "48": "icon/48.png",
    "128": "icon/128.png"
  }
}
